# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment variables
backend/.env
.env
.env.*
!.env.example

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Alembic (keep versions, ignore local state)
backend/alembic/versions/__pycache__/

# Uploads / user files
backend/uploads/
backend/app/uploads/

# Logs
*.log
logs/

# ──────────────────────────────────────────────
# Node.js / Frontend
# ──────────────────────────────────────────────
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/
frontend/.vite/

# Environment variables
frontend/.env
frontend/.env.*
!frontend/.env.example

# Package manager locks (keep one — uncomment your preferred)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ──────────────────────────────────────────────
# IDEs and Editors
# ──────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# ──────────────────────────────────────────────
# OS generated
# ──────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
*.sqlite3
*.db
.claude/
